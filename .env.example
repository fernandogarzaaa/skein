# Environment variables read by skein (all optional). Copy to .env and set as needed.
# Actor name recorded in the event log (defaults to the OS user)
SKEIN_ACTOR=
# Bearer token for the HTTP/dashboard server (alternative to --auth-token)
SKEIN_AUTH_TOKEN=
# Executable used by `skein plan --llm`
SKEIN_PLANNER_CMD=
# Override paths to agent CLIs used by engine adapters
SKEIN_CLAUDE_BIN=
SKEIN_CODEX_BIN=
SKEIN_GEMINI_BIN=
SKEIN_OPENCODE_BIN=
SKEIN_CURSOR_BIN=
SKEIN_AIDER_BIN=
